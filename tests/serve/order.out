<!doctype html>
<title>Order 1</title>
<h1>Order 1</h1>
<p class="error">order 1 was changed by someone else: version is now 2, not 1</p>
<form method="post" action="/order/1">
  <input type="hidden" name="version" value="2">
  <label>Symbol <input name="symbol" value="ZVZZT" required></label>
  <label>Qty <input name="qty" type="number" min="1" step="1" value="7" required></label>
  <label>Price <input name="price" type="number" min="0" step="any" value="1.5" required></label>
  <button>Save</button>
</form>
<p>Version 2, last updated 2026-11-13T12:00:00Z</p>
<p><a href="/order">Back to orders</a></p>

