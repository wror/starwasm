== http://localhost:18473/edit?order=1
HTTP/1.1 200 OK

<!doctype html>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/style.css">
<title>Order 1</title>
<header>
  <h1>Order 1</h1>
  <nav><a href="/">Back to orders</a></nav>
</header>
<main>
  <form method="post" action="/order_request">
    <input type="hidden" name="id" value="1">
    <input type="hidden" name="order.version" value="1">
    <label>Symbol <input name="symbol" value="ZVZZT" required></label>
    <label>Qty <input name="qty" type="number" min="1" step="1" value="1" required></label>
    <label>Price <input name="price" type="number" min="0" step="any" value="1.0" required></label>
    <button>Save</button>
  </form>
  <footer>Version 1, last updated <time>2026-11-13T12:00:00Z</time></footer>
</main>

