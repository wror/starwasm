== -e http://localhost:18473/edit?order=1 -d id=1&order.version=1&symbol=ZVZZT&qty=9&price=1.5 http://localhost:18473/order_request
HTTP/1.1 409 Conflict

<!doctype html>
<meta name="viewport" content="width=device-width, initial-scale=1">
<link rel="stylesheet" href="/style.css">
<title>Order 1</title>
<header>
  <h1>Order 1</h1>
  <nav><a href="/">Back to orders</a></nav>
</header>
<main>
  <p role="alert">order 1 was changed by someone else: version is now 2, not 1</p>
  <form method="post" action="/order_request">
    <input type="hidden" name="id" value="1">
    <input type="hidden" name="order.version" value="2">
    <label>Symbol <input name="symbol" value="ZVZZT" required></label>
    <label>Qty <input name="qty" type="number" min="1" step="1" value="7" required></label>
    <label>Price <input name="price" type="number" min="0" step="any" value="1.5" required></label>
    <button>Save</button>
  </form>
  <footer>Version 2, last updated <time>2026-11-13T12:00:00Z</time></footer>
</main>

