vals = [0.0, -0.0, 1.0, 0.5, 0.1, 1e-4, 1e-5, 123456.0, 1234567.0, 1234567.5, 12345678.9, 1e15, 1e16, 2.5e-10, 1/7, 1e22, 9.999999e5, 99999.99999, 0.000123456789, 5e-324, 1.7976931348623157e308, float("inf"), -float("inf"), float("nan")]
for v in vals:
    print(v, "%g %e %f %G %E" % (v, v, v, v, v), "{}".format(v))
print(float("1_0"), float("-.5e-3"), float("+inf"), float("-Infinity"), float(" 1".strip()), float("1e-400"), 1.5e-3, .25, 7., 1E3)
print(1.0 / 3, 10 / 4, -7 / 2, 8 / 1, 7 // 2.0, 7.5 // -2, -7.5 // 2, 7 % 2.5, -7 % 2.5, 7.25 % -2, 0.0 % 5, 1e300 * 1e10, -1e300 * 1e10)
print(1 < 1.5, 1.5 < 2, 2 <= 2.0, 3 >= 2.9, 1 > float("nan"), float("nan") > float("inf"), max([1, float("nan"), 3]), min(2.5, 1, 3), sorted([2, 1.5, -0.0, 0, float("-inf")]))
d = {}
d[1] = "int"
d[1.0] = "float"
d[2.5] = "x"
print(d, 1 in {1.0: 0}, 2.5 in d, set([1, 1.0, 2.5, 2.5]), hash(1) == hash(1) and {1.5: 1}[1.5])
x = 10
x /= 4
y = 7
y //= 2.0
z = 1.5
z += 1
z *= 2
z -= 0.5
print(x, y, z, type(x), int(x), int(-x), int(1e18), float(True), float(False), float(-3), abs(-1.5), abs(-0.0), -(-1.5), +1.5)
print(9007199254740993 == 9007199254740992.0, 9007199254740993 > 9007199254740992.0, 9223372036854775807 < 9.3e18, -9223372036854775807 - 1 == -9.223372036854775808e18)
