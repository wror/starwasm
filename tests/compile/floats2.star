print(1.5 == 1.5, 1.5 != 1.5, 0.1 * 3 == 0.3, 3 * 0.1, bool(0.0), bool(-0.0), bool(float("nan")), not 0.5, 0.0 or "y", 2.0 and "z")
print(list(range(3))[int(1.9)], [1, 2, 3][1:int(2.5)], "ab" * int(2.0), type(1.0 * 2), type(2 // 1.0), 4.0 == 4, {4: 1} == {4.0: 1})
