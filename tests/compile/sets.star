# Sets: generated core (lib/runtime.star) + methods in lib/prelude.star.
print(dir(set()), hasattr(set(), "union"), hasattr(set(), "keys"))
s = set([3, 1, 2, 1])
print(s, type(s), len(s), 2 in s, 5 in s, 5 not in s, bool(set()), bool(s), str(s), repr(set()))
print(list(s), sorted(s), [x for x in s], set("ab".elems()), set({"k": 1, "j": 2}), set((1, 2)), set(s), set())
a = set([1, 2, 3])
b = set([3, 2, 5])
print(a & b, b & a, a ^ b, b ^ a, a - b, b - a, a | b, b | a)
print(set([1, 2]) == set([2, 1]), set([1]) == set([1, 2]), set([1]) != [1], set() == set(), set([1]) == [1])
print(set([1, 2]) < set([1, 2, 3]), set([1, 2]) <= set([1, 2]), set([1, 3]) > set([1]), set([1]) >= set([1]))
print(set([1, 2]) < set([1, 2]), set([1]) < set([2]), set([1]) <= set([2]), set([2]) >= set([1]), set() < set())
t = set([1])
t.add(2)
t.add(1)
print(t, t.pop(), t)
t.update([5, 6], (7,))
t.update()
t.discard(5)
t.discard(99)
t.remove(6)
print(t)
t.clear()
print(t, len(t))
a = set([1, 2, 3])
b = set([2, 3, 4])
print(a.union(b), a.union([9], (8,)), a.union(), a.intersection(b), a.intersection([3, 2, 9]), a.difference(b), a.difference([1]))
print(a.symmetric_difference(b), a.symmetric_difference([1, 7]), a.difference(b).union(b))
print(a.issubset([1, 2, 3, 4]), a.issubset(b), a.issuperset([1]), a.issuperset(b), set().issubset(a))
u = set([1])
v = u
u |= set([2])
print(u, v)
w = set([1])
z = w
w.update([2])
print(w, z)
x = set([(1, 2), "s", None, True])
print(x, (1, 2) in x, [set([1])] == [set([1])], sorted([set([2]), set([1])]), max(set([3, 1])))
for e in set([3, 1]):
    print(e)
big = set()
for i in range(100):
    big.add(i * 7 % 50)
print(len(big), sorted(big)[:5], 49 in big, set(range(10)) - big)
seen = set()
out = []
for c in "mississippi".elems():
    if c not in seen:
        seen.add(c)
        out.append(c)
print("".join(out), sorted(seen))
