load("modules/structmod.star", "S", "mk")
x = struct(b = 2, a = 1, c = [3])
print(x, type(x), x.a, x.c, dir(x), hasattr(x, "a"), hasattr(x, "z"))
print(getattr(x, "b"), getattr(x, "z", None), str(x), repr(struct()))
print(x == struct(a = 1, b = 2, c = [3]), x == struct(a = 1), struct() == struct(), struct(a = 1) != struct(a = 2))
x.c.append(4)
print(x.c, x)
y = struct(f = lambda n: n * 2, get = "field", items = [1, 2], keys = lambda: "mine")
print(y.f(21), y.get, y.items, y.keys())
print(struct(a = 1, b = 3) + struct(a = 2, c = 4))
print({struct(a = 1): "ok"}[struct(a = 1)], struct(a = (1, 2)) in {struct(a = (1, 2)): 1})
n = struct(inner = struct(v = [1, 2]), name = "n")
print(n.inner.v, n.inner.v[1], n.name.upper(), n.inner)
n.inner.v.append(3)
print(n)
def make(**kw):
    return struct(**kw)
print(make(z = 1, y = 2), make())
print(S, S.l, mk(5), mk(5).v)
print([s.a for s in [struct(a = i) for i in range(3)]])
print("x".upper(), [1, 2].index(2), {"k": 1}.get("k"))
m = struct(split = lambda: "field split")
for o in [m, "a b"]:
    print(o.split())
print(sorted([struct(k = 2), struct(k = 1)], key = lambda s: s.k))
print(struct(s = b"\xff", t = "q"), [struct()])
