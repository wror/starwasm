print(hasattr("x", "split"), hasattr([], "split"), hasattr({}, "keys"), hasattr(1, "x"))
print(min(3, 1, 2), max([3, 1, 2]), min("b", "a"), max([1, 5], key = lambda x: -x), min([(2, "a"), (1, "b")]))
print(zip([1, 2, 3], "ab".elems()), zip(), zip([1]), reversed([1, 2, 3]), reversed((1, 2)), reversed({"a": 1, "b": 2}))
print(" a  b ".split(), "a,b,,c".split(","), "a,b,c".split(",", 1), "  a b c ".split(None, 1), "".split(), "".split(","))
print("a,b,c".rsplit(",", 1), " a b c ".rsplit(None, 1), "a b".rsplit())
print("a\nb\r\nc\rd\n".splitlines(), "a\nb\n".splitlines(True), "".splitlines())
print(repr(" \t x \n".strip()), "xxhixx".strip("x"), "abcba".lstrip("ab"), "abcba".rstrip("ab"), " x ".lstrip(), " x ".rstrip())
print("aaa".replace("a", "b"), "aaa".replace("a", "b", 2), "abc".replace("", "-"), "abc".replace("x", "y"), "aaa".replace("a", "b", -1), "aaa".replace("a", "b", 0))
print("hello".find("l"), "hello".rfind("l"), "hello".find("z"), "hello".find("l", 3), "hello".find("l", -2), "hello".find("", 2), "hello".find("h", 1, 3), "hello".index("e"), "hello".rindex("l"))
print("hello".count("l"), "aaaa".count("aa"), "abc".count(""), "hello".count("l", 3), "hello".count("l", 0, 3))
print("a=b=c".partition("="), "a=b=c".rpartition("="), "abc".partition("x"), "abc".rpartition("x"))
print("prefix_x".removeprefix("prefix_"), "x_suf".removesuffix("_suf"), "x".removeprefix("y"))
print("Hello World".upper(), "Hello World".lower(), "hello world foo".title(), "hELLO wORLD".capitalize(), "o'neil 2x".title())
print("abc".isalpha(), "ab1".isalpha(), "".isalpha(), "123".isdigit(), "12a".isdigit(), "ab12".isalnum(), "a b".isalnum(), " \t\n".isspace(), "".isspace())
print("abc".islower(), "aBc".islower(), "123".islower(), "ABC".isupper(), "A1".isupper(), "Hello World".istitle(), "Hello world".istitle(), "".istitle())
print("ab".startswith(("x", "a")), "ab".endswith(("x", "b")), "ab".startswith(()), "ab".endswith("ab"))
print("{} and {}".format(1, "x"), "{0}{1}{0}".format("a", "b"), "{name}!".format(name = "N"), "{!r} {!s}".format("q", "q"), "{{x}}".format(), "{0!r}".format([1]))
print(list("héllo".codepoints()), list("héllo".codepoint_ords()))
l = [1, 2, 3]
l.insert(0, 0)
l.insert(-1, 9)
l.insert(100, 7)
l.remove(9)
print(l, l.index(2), l.index(7, 2), [1, 2, 1].index(1, 1))
l.clear()
print(l)
d = {"a": 1, "b": 2}
d.update({"c": 3}, d = 4)
d.update([("e", 5)])
d.update(a = 10)
