# % formatting, sorted, all/any, elem_ords.
print("%s|%r|%d|%i" % ("str", "str", 42, -7))
print("%x %X %o %c %c" % (255, 255, 8, 65, "z"), "%x" % -255)
print("100%%", "%s" % [1, "a"], "%r" % ((1, 2),), "%s and %s" % (None, True))
print("%(name)s is %(age)d" % {"name": "Ann", "age": 30})
print("no args" % (), "single %s" % "x", "%s-%s" % ("a", "b"))
print("%d%%" % 50, "%s" % "é", "<%r>" % "q\"\n")
print(sorted([3, 1, 2]), sorted("bca".elems()), sorted([(2, "b"), (1, "z"), (2, "a")]))
print(sorted([3, 1, 2], reverse = True), sorted(["bb", "a", "ccc"], key = len))
print(sorted([(1, "x"), (0, "y"), (1, "a"), (0, "b")], key = lambda p: p[0]))
print(sorted([(1, "x"), (0, "y"), (1, "a"), (0, "b")], key = lambda p: p[0], reverse = True))
print(sorted({"b": 1, "a": 2}), sorted([]), sorted(range(20), key = lambda n: -n)[:3])
words = "the quick brown fox jumps over the lazy dog".elems()
print(len(sorted(words)), sorted(words)[-3:])
print(all([]), all([1, "a"]), all([1, 0]), any([]), any([0, ""]), any([0, 2]))
print(list("é!".elem_ords()), list("".elem_ords()))
